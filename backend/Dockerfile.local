FROM recon-webapp-backend-base:latest

WORKDIR /app
ENV RECON_DATA_DIR=/data \
    DEFAULT_FFUF_WORDLIST=/usr/share/seclists/Discovery/Web-Content/common.txt \
    PATH=/root/go/bin:/opt/venv/bin:$PATH

# The base image already contains Kali, SecLists, Chromium, Go tools, and Python deps.
# Keep dependency installation out of normal application rebuilds.
COPY requirements.txt /app/requirements.txt
RUN /opt/venv/bin/pip install --no-cache-dir -r /app/requirements.txt
COPY wordlists /app/wordlists
COPY app /app/app

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
